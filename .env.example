# MongoDB Connection URI
# When running python locally on the host machine, use localhost (127.0.0.1:27017).
# In a Docker network, services communicate by service name (e.g., mongodb://mongo:27017).
MONGO_URI=mongodb://localhost:27017/

# Target Database Name for marketing analytics
DB_NAME=marketing

# Target Collection Name storing cleaned campaign records
COLLECTION_NAME=bank_campaigns
